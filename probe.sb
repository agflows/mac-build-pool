(version 1)
(deny default)
(allow process*)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)
(allow file-read* (subpath "/"))
(allow file-map-executable (subpath "/"))
(deny file-read* (subpath "/Users/leolurch"))
(deny file-map-executable (subpath "/Users/leolurch"))
(allow file-write* (subpath "/private/tmp"))
(allow file-write* (subpath "/tmp"))
